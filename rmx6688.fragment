# Kconfig fragment for realme GT7 (RMX6688) / MT6991 mainline bring-up.
# Merged on top of arch/arm64/configs/defconfig by build.sh.
#
# Theme: everything needed to see a log on the panel must be BUILT IN.  The
# arm64 defconfig ships DRM, pstore and friends as modules, and there is no
# rootfs to load modules from on a first boot.

# --- Console on the bootloader's framebuffer -------------------------------
# FB_SIMPLE binds the /chosen/framebuffer node the bootloader left scanning
# out.  It is mutually exclusive with DRM_SIMPLEDRM, so that stays off.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# Deferred takeover would hold back the log until userspace writes to the
# console -- exactly the output we are trying to see.  Keep it off.
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y

# The boot logo doubles as a one-glance test of the framebuffer parameters: a
# clean Tux means width/height/stride/format are all correct.  Skewed or
# colour-swapped penguins point straight at which one is wrong.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# --- Do not let the bootloader's watchdog reset us ------------------------
# The bootloader arms TOPRGU before jumping to the kernel.  This driver spots
# the already-running watchdog and the watchdog core then pets it from a
# kernel worker, which is what keeps the phone alive past the first seconds.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_MEDIATEK_WATCHDOG=y

# --- Persistent log across reset (the real bring-up debug channel) --------
# Built in, not modular: a boot that dies before userspace still has to be
# able to record why.  Reboot into Android afterwards and read
# /sys/fs/pstore/console-ramoops-0.  Compression off so the log stays
# readable as plain text.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_COMPRESS is not set

# --- Printk ring ----------------------------------------------------------
# 512 KiB ring instead of the 128 KiB default.  The UFS driver alone can log
# 100 KiB+ during probe, which would otherwise wrap away the early records
# (the ramoops probe's own lines at ~0.02s) before init reads /dev/kmsg back.
CONFIG_LOG_BUF_SHIFT=19

# --- Serial ---------------------------------------------------------------
# UART0 exists and the bootloader uses it, but on retail hardware the pads
# come out only through the USB connector with a factory cable.  Built in so
# that earlycon=uart8250,mmio32,0x16000000 works for anyone who has one.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- USB-C host (OTG) -----------------------------------------------------
# The port runs as a USB host: mtu3 host-only plus the mtk-xhci child, so
# keyboards / mice / U-disks work behind an OTG adapter.  The debug
# serial/RNDIS gadget is retired (logs go over WiFi and the panel).  Port
# VBUS comes from the MT6379 OTG boost, enabled by mt6379_charger.c; HID
# and storage class drivers are already built in.
#
# Host-only build: mtu3_probe() forces dr_mode=HOST, and the host path skips
# the vbus-supply/role-switch dance (vusb33-supply stays mandatory and comes
# from the board DTS's fixed regulator).  No gadget roles at all -- nothing
# plugs the phone into a PC anymore.
CONFIG_USB_SUPPORT=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_HOST=y
# CONFIG_USB_GADGET is not set
CONFIG_PHY_MTK_XSPHY=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- I2C6 + NXP eUSB2 repeater (USB-C data path) --------------------------
# The USB-C port uses an eUSB2 architecture: mtu3 → xsphy → NXP PTN36241
# repeater (I2C6 @0x4f) → connector.  Without the repeater the host never
# sees the device.
#
# COMMON_CLK_MT8196 gates the peri-ao and vlp clocks; IMP_IIC_WRAP gates
# the per-I2C-bus clocks.  Both must be built-in so they register before
# i2c-mt65xx probes (it uses devm_clk_get, not optional).
CONFIG_COMMON_CLK_MT8196=y
CONFIG_COMMON_CLK_MT8196_IMP_IIC_WRAP=y
CONFIG_I2C_MT65XX=y
CONFIG_PHY_MTK_NXP_EUSB2_REPEATER=y
CONFIG_PHY_MTK_MT6379_EUSB2_REPEATER=y

# --- Android /data probe (f2fs) ------------------------------------------
# init mounts userdata (GPT partition 95 = /dev/block/by-name/userdata) to
# list its first-level entries.  File-based encryption does not block the
# mount or the top-level readdir -- only per-user subtrees are locked -- so
# this works keyless; the magic check in init tells us if the phone instead
# uses metadata encryption (whole partition dm-crypt'd, superblock hidden).
# Mount is read-only, so Android's next boot sees an untouched filesystem.
CONFIG_F2FS_FS=y
CONFIG_FS_ENCRYPTION=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# --- Built-in initramfs ---------------------------------------------------
# Self-contained rootfs so the kernel has an init to run and stays up instead
# of panicking.  Path is filled in by build.sh.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
# zstd: shrinks the 14.3 MB raw cpio to ~4.0 MB in the image (~10 MB off
# the boot image; boot-time zstd decompress is a few tens of ms).
CONFIG_INITRAMFS_COMPRESSION_ZSTD=y
# The bootloader hands us vendor_boot's ramdisk too.  Without FORCE it gets
# unpacked on top of ours and replaces /init with Android's, which then fails
# on the missing vendor kernel it expects.  Needs CMDLINE_FORCE, which is set
# below.
CONFIG_INITRAMFS_FORCE=y

# --- Device tree embedded in the kernel image -----------------------------
# The bootloader's DTB lives in vendor_boot and gets dtbo overlays applied to
# it, so replacing it in place means matching a base tree with 1360
# /__symbols__ entries.  Linking our own tree into the image sidesteps that
# entirely: only the boot partition has to be flashed, and the bootloader's
# tree is used for nothing but the DRAM bank layout.
CONFIG_ARM64_EMBEDDED_DTB=y
CONFIG_ARM64_EMBEDDED_DTB_SOURCE="arch/arm64/boot/dts/mediatek/mt6991-realme-rmx6688.dtb"

# --- Command line ---------------------------------------------------------
# FORCE, not FROM_BOOTLOADER: the MediaTek bootloader replaces bootargs with a
# long vendor command line that lists console=ttynull ahead of console=tty0
# and points root= at partitions we are not using.  Overriding it gives a
# deterministic first boot.
#
# panic=0 is deliberate -- on a panic the kernel stops instead of rebooting,
# so the backtrace stays on screen to be read (and photographed).
# Add earlycon=uart8250,mmio32,0x16000000 if you have a UART cable, and
# initcall_debug if you need to find where a silent hang happens.
#
# The USB port is a host now (OTG adapter, see the USB section above), so
# the serial/RNDIS gadget console is retired: the only console is tty0 on
# the framebuffer, and logs are collected over the rootfs instead.
#
# clk_ignore_unused is required once the MT8196 TOPCKGEN driver registers its
# full clock table: "clk: Disabling unused clocks" would otherwise turn off
# every gate the bootloader left enabled but no mainline driver claims yet --
# including, quite possibly, the display pipeline the framebuffer prints
# through.  With the flag the kernel leaves hardware exactly as handed over.
CONFIG_CMDLINE="earlycon=uart8250,mmio32,0x16000000 console=ttyS0,115200n8 console=tty0 ignore_loglevel no_console_suspend pm_debug_messages panic=0 nokaslr clk_ignore_unused pd_ignore_unused eusb2_keep_calib cma=256M swiotlb=65536 printk.devkmsg=on"
CONFIG_CMDLINE_FORCE=y

# --- Build hygiene on-device ---------------------------------------------
# No openssl headers in this environment, and debug info would cost a lot of
# build time and disk for no benefit here.
# CONFIG_MODULE_SIG is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set

# --- DRM Display (panel driver) -------------------------------------------
# DRM must be built-in (=y) for the panel to probe during boot.  The module
# build won't work because there's no rootfs to modprobe from.
#
# All DRM dependencies MUST be =y or DRM_MEDIATEK gets silently demoted to
# =m by Kconfig.  This is the full chain needed for MTK DSI output.
CONFIG_DRM=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_CLIENT=y
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# Force all DRM core helpers to built-in (defconfig ships them as modules)
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_CLIENT_LIB=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_VRAM_HELPER=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_GPUVM=y
CONFIG_DRM_TTM=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y

# MTK CMDQ (must be =y — its dependency chain blocks DRM_MEDIATEK from =y)
CONFIG_MTK_CMDQ=y
CONFIG_MTK_CMDQ_MBOX=y
CONFIG_MTK_INFRACFG=y
CONFIG_MAILBOX=y

# MT6991 SCP/SPM power domains.  Needed so the mddriver can attach to the
# MD domain (its power-on clears the SLEEP0/1_MD AXI bus protectors the
# modem needs).  The port's init deliberately leaves the bootloader's MTCMOS
# state untouched, so the live PCIe/WiFi domains are not reset.
CONFIG_MTK_SCPSYS_MT6991=y

# --- SCP (RV33) tinysys framework -----------------------------------------
# The modem's CCISM core (MD side) syncs with the AP/SCP; without a running
# SCP the MD's ccismcore times out and asserts.  Ports the vendor scp/rv
# driver plus its mtk-mbox/mtk-ipi/rpmsg infrastructure.
#
# Step 1c: infra + SCP driver, with the vendor SCP's scp_ipi_send symbol
# renamed to scp_ipi_send_legacy to rule out a link collision with mainline's
# scp_ipi_send.  Still no scp@1c800000 DTS node (nothing probes).
CONFIG_RPMSG=y
CONFIG_MTK_MBOX=y
CONFIG_RPMSG_MTK_MBOX=y
CONFIG_MTK_IPI=y
# Build the SCP as a loadable module so its code is NOT linked into vmlinux
# (the built-in SCP code hangs the ATF at boot).  Loaded from the initramfs.
CONFIG_MTK_TINYSYS_SCP_SUPPORT=m
# The SCP logger makes the SCP wedge (wdt reset loop) on this port, so keep
# it off.  (Kconfig is tristate and the gate handles _MODULE, so it can be
# turned on again later.)
# CONFIG_MTK_TINYSYS_SCP_LOGGER_SUPPORT is not set
# CONFIG_MTK_TINYSYS_SCP_DEBUG_SUPPORT is not set
# Connectivity <-> SCP bridge (connscp.ko): SCP READY handling + connsys/SHM
# setup + SCP-offloaded conn services.  Loaded after scp.ko.
CONFIG_MTK_CONN_SCP=m

# MT8196/MT6991 display clock gate drivers (mmsys0/mmsys1/ovl/vdisp)
CONFIG_COMMON_CLK_MT8196_MMSYS=y

# MFG (GPU) subsystem clock gate — enables the bg3d gate that the
# panthor driver's power path may request.
CONFIG_COMMON_CLK_MT8196_MFGCFG=y

# MTK display subsystem (built-in for MT6991 DSI + OVL + DDP pipeline)
CONFIG_DRM_MEDIATEK=y
CONFIG_MTK_MMSYS=y
CONFIG_PHY_MTK_MIPI_DSI=y

# The ae031 panel driver (1280x2800, DSI video mode, DSC)
CONFIG_DRM_PANEL_AE031_DSI_VDO=y

# --- GPU (ARM Immortalis-G925) ---------------------------------------------
# panthor is the mainline DRM driver for ARMv9 Mali/Immortalis GPUs.
# Must be built-in (=y) because there are no kernel modules on the rootfs.
# Dependencies (DRM_SCHED, DRM_GPUVM, DRM_EXEC, DRM_TTM) are already =y above.
CONFIG_DRM_PANTHOR=y

# --- udmabuf (DMA-BUF userspace allocator) ---------------------------------
# KWin creates its software RenderDevice from /dev/udmabuf.  Without it,
# DrmGpu registers the KMS node (card0) as a fallback render device; on this
# split display/render setup card0 has no render node, so KWin advertises it
# as the linux-dmabuf main device and Mesa clients fail EGL with fd -1,
# falling back to software rendering.  Built-in: no modules on the rootfs.
CONFIG_UDMABUF=y

# Backlight (built-in so panel can set brightness at boot)
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Touchscreen (Synaptics S3910 on SPI6) --------------------------------
# Built-in so the touchscreen works during init for testing.  The SPI
# controller must also be enabled.
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MT65XX=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=y

# --- CPU features (IFUNC/SIGILL workaround) --------------------------------
# The glibc IFUNC dispatchers select SVE-optimized code paths based on
# HWCAP, but the mainline kernel does not properly set up CPACR_EL1.ZEN
# for userspace SVE access on this SoC.  Disable SVE/SME in the kernel
# so HWCAP bits are not advertised, preventing glibc from choosing those
# code paths and crashing with SIGILL.
CONFIG_ARM64_SVE=y
CONFIG_ARM64_SME=y

# --- CMA (Contiguous Memory Allocator) ------------------------------------
# DRM dumb buffer allocation needs CMA.  Default is 32 MiB which is too
# small for GNOME Shell triple-buffering on a 12800x2800 display.
CONFIG_CMA_SIZE_MBYTES=256

# --- CPU DVFS (mediatek-cpufreq-hw) ---------------------------------------
# MT6991 uses the hardware-DVFS "performance domain" controller (one per
# cluster); the driver reads the frequency LUT from the SoC and writes the
# performance state back.  Built in so the CPU clusters get a cpufreq policy
# at boot (there are no kernel modules on the rootfs).
CONFIG_ARM_MEDIATEK_CPUFREQ_HW=y

# --- IMU: Bosch BMI270/BMI260 accelerometer + gyroscope (I2C1) ------------
# Built in (no modules on the rootfs).  BMI270_I2C selects the core and
# REGMAP_I2C; IIO_TRIGGERED_BUFFER has to be built in as well.
CONFIG_BMI270_I2C=y
CONFIG_REGMAP_I2C=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGERED_BUFFER=y

# --- Thermal: MT6991 LVTS (vendor soc_temp_lvts port) ---------------------
# The mainline lvts_thermal driver stops at MT8196; MT6991 uses the vendor
# soc_temp_lvts driver whose calibration comes from the bootloader devinfo
# NVMEM table (nvmem-mtk-devinfo).  All built in so the thermal zones exist
# at boot.
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL_LVTS=y
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_DEVINFO=y
CONFIG_RESET_TI_SYSCON=y

# --- Connectivity: MT6991 connv3 / MT6653 2g2a WiFi stack (built-in) -------
# Full Android port of conninfra + connadp + connfem + gen4m wlan (PCIe HIF).
CONFIG_MTK_COMBO=y
CONFIG_MTK_COMBO_CHIP_CONSYS_6991=y
# cfg80211/rfkill must be built-in so the built-in gen4m driver links.
CONFIG_CFG80211=y
CONFIG_RFKILL=y

# --- PCIe: MT6991 host + PHY (vendor full port) ---------------------------
# Needed to enumerate the MT6653 Wi-Fi endpoint on PCIe.
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PHY_MTK_PCIE=y

# --- Bluetooth: MT6991 connv3 / MT6653 2g2a (built-in) --------------------
# Full Android port of bt/linux_v2 (UART tty + connv3 power).  BlueZ needs a
# kernel HCI device, so the Bluetooth core must be built-in (=y) for the
# built-in BT driver to link against hci_alloc_dev/hci_register_dev.
CONFIG_BT=y
CONFIG_BT_BREDR=y
# The BT UART is routed through the UARTHUB block; the driver is now ported
# and the board DTS starts the BT controller in hub mode (hub-en = 1).
CONFIG_MTK_UARTHUB=y

# Mainline MTK BT core + UART(serdev/H4) transport.  MT6653/MT6991 support
# was added; BT_HCIUART must be =y too (tristate dependency) so btmtkuart can
# be built-in.  Bound via the uart3 serdev child node.
CONFIG_BT_HCIUART=y
CONFIG_BT_MTKUART=y

# --- SPMI + MT6379 charger (5V standard charging) -------------------------
# The MT6379 is an SPMI PMIC (USID 0x0e); build the PMIF controller and the
# minimal charger driver in so it re-asserts the input current limit on every
# (re)plug (the bootloader leaves AICR at 500 mA).
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGMAP_SPMI=y
CONFIG_REGMAP_IRQ=y
CONFIG_CHARGER_MT6379=y

# --- MT6363 (main PMIC, SPMI USID 4) ---------------------------------------
# The vendor MTK SPMI PMIC MFD (drivers/mfd/mtk-spmi-pmic.c) + MT6363
# regulator driver are in the tree but stay OFF: the PMIC answers SPMI only
# after it is woken, and the MFD's first (CID) read times out (-110) on this
# port, which also leaves the SWINF busy enough to make init's raw-SPMI
# mt6363 writes silent no-ops.  Until that is sorted out the MD rails are
# driven by init-rootfs.c's md_rails_up(), which falls back to raw SPMI
# whenever the regulator driver is not the owner.
# CONFIG_MFD_MTK_SPMI_PMIC / CONFIG_REGULATOR_MT6363

# --- MT6373 (second PMIC, SPMI USID 5): touch VCI + amp rails -------------
# Full vendor port (drivers/regulator/mt6373-regulator.c) stays in the tree
# but is OFF: it talks through devm_regmap_init_spmi_ext(), and every 16-bit
# extended register access (PMIF_CMD_EXT_REG_LONG) times out waiting for
# SWINF_WFVLDCLR in the mainline PMIF driver, so all 39 rails fail to
# register (and it spams ~40 error lines per boot).  Short (8-bit) register
# accesses on the same channel work fine, which is what the keys/charger use.
# The VTP rail the touch panel needs is raised instead by the early sequence
# driver below; keep this off until the PMIF long-address path is fixed.
# CONFIG_REGULATOR_MT6373

# --- Early board rails (mt6991-pmic-early) --------------------------------
# Runs the devicetree rail sequences (touch VTP now; MD bucks / amp reset /
# codec GPIO to follow) at subsys_initcall -- strictly before any
# device_initcall consumer such as the SPI6 controller.  Uses a bare
# SWINF handshake, so it does not depend on the broken PMIF long path.
CONFIG_MT6991_PMIC_EARLY=y


# --- Modem / CCCI (M80: CCIF + DPMAIF) ------------------------------------
# MT6991 gen97 modem stack ported in-tree from the vendor kernel
# (android_kernel_modules_and_devicetree_oneplus_mt6991).  Built-in so it
# links into the Image (build.sh only produces Image, not modules).
CONFIG_MTK_CCCI_DEVICES=y
CONFIG_MTK_ECCCI_DRIVER=y
CONFIG_MTK_NET_CCMNI=y
CONFIG_PAGE_POOL=y
# RAT capability bitmap for N/Lf/Lt/W/G (see vendor build.prop).
CONFIG_MTK_MD1_SUPPORT=14
CONFIG_MTK_NET_RPS=y

# Vendor MT6991 clock tree (cksys / vlp_cksys) for the SCP DVFS.
CONFIG_CLK_MT6991=m

# --- Fingerprint: Goodix UFF over REE SPI on SPI3 --------------------------
# No TEE: the driver exposes /dev/fingerprint_dev and raw SPI transfers.
CONFIG_UFF_FINGERPRINT_REE_SPI=y

# --- Haptics: Awinic AW86927 on i2c5 ---------------------------------------
# Mainline has drivers/input/misc/aw86927.c (FF-memless); the phone uses
# AW86927 (chip id 0x9270).  Built-in so it lands in the Image.
CONFIG_INPUT_AW86927=y

# --- Buttons: power / volume-up (MT6363 PMIC) + volume-down (GPIO11) -------
# Power and volume-up are the MT6363 PWRKEY/HOMEKEY lines.  The MT6991 SPMI
# controller runs without an IRQ domain, so the keys are polled (TOPSTATUS)
# instead of using the PMIC interrupts.  Volume-down uses the standard
# gpio-keys driver (KEYBOARD_GPIO is already =y from the defconfig).
CONFIG_INPUT_MT6363_SPMI_KEYS=y

# --- System suspend (s2idle) ----------------------------------------------
# CONFIG_SUSPEND/PM_SLEEP are already =y in defconfig.  s2idle ("freeze") is
# the only usable state until the MT6991 SPM/SPM-suspend path is ported.
# PM_DEBUG exposes /sys/power/pm_test to bisect a hanging suspend.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# --- Audio: MT6991 AFE -----------------------------------------------------
# MT6991 shares the MT8196 AFE register layout, so the mainline mt8196 AFE
# driver (SND_SOC_MT8196) drives it.  Built-in: no modules on the rootfs.
# CONFIG_SOUND gates CONFIG_SND, so it must be =y too (defconfig ships =m).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MEDIATEK=y
CONFIG_SND_SOC_MT8196=y
CONFIG_SND_SOC_MT8196_RMX6688=y
CONFIG_SND_SOC_MTK_SP_SPK_AMP=y
CONFIG_SND_SOC_TFA9874=y

# --- Other-SoC trim ---------------------------------------------------------
# The phone is MT6991 only, but the arm64 defconfig enables platform support
# for every other SoC family.  Their drivers are gated behind their ARCH_*
# platform option (or select it), so dropping the platform entries removes
# the whole family from the image: clk/qcom 2.2 MB, pinctrl/qcom 1.7 MB,
# interconnect/qcom 0.7 MB, clk/rockchip 0.6 MB, clk/samsung 0.6 MB,
# clk/meson+sunxi-ng+renesas+tegra+imx+sprd ~1.3 MB, driver glue ~2 MB.
# Generated from the set of CONFIG_ARCH_*=y symbols in the pre-trim .config,
# minus CONFIG_ARCH_MEDIATEK (KEEP).  ARCH_HAS_*/ARCH_SUPPORTS_*/ARCH_WANT*
# are capability symbols, not platforms -- not listed.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Renesas per-SoC menus (R-Car / RZ), in case a top-level gate is not enough.
# CONFIG_ARCH_RCAR_GEN3 is not set
# CONFIG_ARCH_RCAR_GEN4 is not set
# CONFIG_ARCH_RCAR_GEN5 is not set
# CONFIG_ARCH_RZG2L is not set
# CONFIG_ARCH_R8A774A1 is not set
# CONFIG_ARCH_R8A774B1 is not set
# CONFIG_ARCH_R8A774C0 is not set
# CONFIG_ARCH_R8A774E1 is not set
# CONFIG_ARCH_R8A77951 is not set
# CONFIG_ARCH_R8A77960 is not set
# CONFIG_ARCH_R8A77961 is not set
# CONFIG_ARCH_R8A77965 is not set
# CONFIG_ARCH_R8A77970 is not set
# CONFIG_ARCH_R8A77980 is not set
# CONFIG_ARCH_R8A77990 is not set
# CONFIG_ARCH_R8A77995 is not set
# CONFIG_ARCH_R8A779A0 is not set
# CONFIG_ARCH_R8A779F0 is not set
# CONFIG_ARCH_R8A779G0 is not set
# CONFIG_ARCH_R8A779H0 is not set
# CONFIG_ARCH_R8A78000 is not set
# CONFIG_ARCH_R9A07G043 is not set
# CONFIG_ARCH_R9A07G044 is not set
# CONFIG_ARCH_R9A07G054 is not set
# CONFIG_ARCH_R9A08G045 is not set
# CONFIG_ARCH_R9A08G046 is not set
# CONFIG_ARCH_R9A09G011 is not set
# CONFIG_ARCH_R9A09G047 is not set
# CONFIG_ARCH_R9A09G056 is not set
# CONFIG_ARCH_R9A09G057 is not set
# CONFIG_ARCH_R9A09G077 is not set
# CONFIG_ARCH_R9A09G087 is not set

# --- Unused subsystems ------------------------------------------------------
# No SATA (ATA 0.3 MB), no ACPI (pure DT platform, 0.6 MB), no EFI runtime
# (lk bootloader, 0.2 MB), no MTD/NFS/SUNRPC (ext4/f2fs only; NFS+SUNRPC was
# the single biggest in-kernel filesystem stack left, ~1 MB), and the USB
# controllers on this SoC are MTU3 + MTK XHCI only -- DWC2/DWC3/CHIPIDEA/
# EHCI/OHCI/PCI-XHCI glue (DWC2+DWC3 ~0.35 MB) are dead code.
#
# CONFIG_SCSI is kept explicit: in the defconfig it was only =y through
# ATA's "select SCSI" (the defconfig enables the UFS host stack via
# SCSI_UFSHCD but never CONFIG_SCSI itself), so dropping ATA silently killed
# SCSI and with it the UFS rootfs disk (sd_mod).
CONFIG_SCSI=y
# CONFIG_ATA is not set
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_MTD is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_SUNRPC is not set
# CONFIG_PHYLIB is not set
# CONFIG_USB_CHIPIDEA is not set
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_XHCI_PCI is not set

# --- WiFi hotspot NAT (nftables, IPv4) --------------------------------------
# hostapd + dnsmasq + nft masquerade on uap0 -> wlan0.  Keep these as y so the
# rules work before the Ubuntu rootfs has loaded any module.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
